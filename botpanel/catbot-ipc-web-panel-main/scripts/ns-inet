#!/usr/bin/env bash
set -Eeuo pipefail

botid="${1:-}"
if [[ ! "$botid" =~ ^[0-9]+$ ]] || (( botid < 1 || botid > 254 )); then
    echo "bot id must be an integer from 1 to 254" >&2
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    echo "You must be root to run this script"
    exit 1
fi

get_default_interface() {
    local interface=""

    if [[ -n "${CATHOOK_NET_INTERFACE:-}" ]]; then
        printf '%s\n' "$CATHOOK_NET_INTERFACE"
        return
    fi

    interface="$(ip -o -4 route get "${CATHOOK_NET_PROBE_HOST:-1.1.1.1}" 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "dev" && (i + 1) <= NF) {
                    print $(i + 1)
                    exit
                }
            }
        }')"

    if [[ -n "$interface" ]]; then
        printf '%s\n' "$interface"
        return
    fi

    ip -o -4 route show default 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "dev" && (i + 1) <= NF) {
                    print $(i + 1)
                    exit
                }
            }
        }'
}

state_dir="${CATHOOK_NET_STATE_DIR:-/run/cathook-catbot}"
lock_path="$state_dir/network.lock"
state_path="$state_dir/state"
mkdir -p "$state_dir"
chmod 700 "$state_dir"
exec {lock_fd}>"$lock_path"
flock "$lock_fd"

NS="catbotns$botid"
VETH="veth$botid"
VPEER="vpeer$botid"
VETH_ADDR="10.200.$botid.1"
VPEER_ADDR="10.200.$botid.2"
INTERFACE="$(get_default_interface)"

if [[ -z "$INTERFACE" || ! "$INTERFACE" =~ ^[a-zA-Z0-9_.:-]+$ ]] || ! ip link show "$INTERFACE" >/dev/null 2>&1; then
    echo "Could not find default network interface with ip route" >&2
    exit 1
fi

state_count() {
    if [[ ! -f "$state_path" ]]; then
        printf '0\n'
        return
    fi
    awk 'NR > 1 && NF { count++ } END { print count + 0 }' "$state_path"
}

state_interface() {
    [[ -f "$state_path" ]] && awk -v id="$botid" 'NR > 1 && $1 == id { print $2; exit }' "$state_path"
}

state_remove_id() {
    [[ -f "$state_path" ]] || return 0
    local temporary_path="${state_path}.tmp.$$"
    awk -v id="$botid" 'NR == 1 || $1 != id' "$state_path" > "$temporary_path"
    mv "$temporary_path" "$state_path"
}

state_prune() {
    [[ -f "$state_path" ]] || return 0
    local namespaces
    namespaces="$(ip netns list 2>/dev/null)" || return 0
    local temporary_path="${state_path}.tmp.$$"
    {
        head -n 1 "$state_path"
        while read -r id interface _; do
            [[ -n "$id" ]] || continue
            if grep -Eq "^catbotns${id}([[:space:]]|$)" <<< "$namespaces"; then
                printf '%s %s\n' "$id" "$interface"
            fi
        done < <(tail -n +2 "$state_path")
    } > "$temporary_path"
    mv "$temporary_path" "$state_path"
}

state_original_forward() {
    if [[ -s "$state_path" ]]; then
        head -n 1 "$state_path"
    else
        cat /proc/sys/net/ipv4/ip_forward
    fi
}

remove_rules() {
    local interface="$1"
    [[ -n "$interface" ]] || return 0
    iptables -t nat -D CATHOOK_CATBOT -s "${VPEER_ADDR}/24" -o "$interface" -j MASQUERADE 2>/dev/null || true
    iptables -D CATHOOK_CATBOT -i "$interface" -o "$VETH" -j ACCEPT 2>/dev/null || true
    iptables -D CATHOOK_CATBOT -o "$interface" -i "$VETH" -j ACCEPT 2>/dev/null || true
}

remove_global_rules() {
    iptables -t nat -F CATHOOK_CATBOT 2>/dev/null || true
    iptables -F CATHOOK_CATBOT 2>/dev/null || true
    iptables -t nat -D POSTROUTING -j CATHOOK_CATBOT 2>/dev/null || true
    iptables -D FORWARD -j CATHOOK_CATBOT 2>/dev/null || true
    iptables -t nat -X CATHOOK_CATBOT 2>/dev/null || true
    iptables -X CATHOOK_CATBOT 2>/dev/null || true
}

OLD_FORWARD="$(state_original_forward)"
OLD_INTERFACE="$(state_interface || true)"
if [[ ! "$OLD_FORWARD" =~ ^[01]$ ]]; then
    OLD_FORWARD=1
fi
if [[ ! -f "$state_path" ]]; then
    printf '%s\n' "$OLD_FORWARD" > "$state_path"
fi
state_prune

cleanup_failed() {
    trap - ERR INT TERM
    remove_rules "$OLD_INTERFACE"
    remove_rules "$INTERFACE"
    ip link del "$VETH" 2>/dev/null || true
    ip netns del "$NS" 2>/dev/null || true
    state_remove_id || true
    if (( $(state_count) == 0 )); then
        remove_global_rules
        if printf '%s\n' "$OLD_FORWARD" > /proc/sys/net/ipv4/ip_forward 2>/dev/null; then
            rm -f "$state_path"
        fi
    fi
    exit 1
}
trap cleanup_failed ERR INT TERM

remove_rules "$OLD_INTERFACE"
remove_rules "$INTERFACE"
ip netns del "$NS" 2>/dev/null || true
ip link del "$VETH" 2>/dev/null || true
state_remove_id

iptables -t nat -N CATHOOK_CATBOT 2>/dev/null || true
iptables -N CATHOOK_CATBOT 2>/dev/null || true
iptables -t nat -C POSTROUTING -j CATHOOK_CATBOT 2>/dev/null || iptables -t nat -A POSTROUTING -j CATHOOK_CATBOT
iptables -C FORWARD -j CATHOOK_CATBOT 2>/dev/null || iptables -A FORWARD -j CATHOOK_CATBOT

ip netns add "$NS"
ip link add "$VETH" type veth peer name "$VPEER"
ip link set "$VPEER" netns "$NS"
ip addr add "${VETH_ADDR}/24" dev "$VETH"
ip link set "$VETH" up
ip netns exec "$NS" ip addr add "${VPEER_ADDR}/24" dev "$VPEER"
ip netns exec "$NS" ip link set "$VPEER" up
ip netns exec "$NS" ip link set lo up
ip netns exec "$NS" ip route add default via "$VETH_ADDR"
printf '1\n' > /proc/sys/net/ipv4/ip_forward
iptables -t nat -A CATHOOK_CATBOT -s "${VPEER_ADDR}/24" -o "$INTERFACE" -j MASQUERADE
iptables -A CATHOOK_CATBOT -i "$INTERFACE" -o "$VETH" -j ACCEPT
iptables -A CATHOOK_CATBOT -o "$INTERFACE" -i "$VETH" -j ACCEPT
printf '%s %s\n' "$botid" "$INTERFACE" >> "$state_path"
trap - ERR INT TERM
