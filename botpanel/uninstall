#!/usr/bin/env bash
set -euo pipefail

read -r -p "This removes generated botpanel/runtime files, not bundled source. Press ENTER to continue"

echo "Removing legacy..."

./remove-legacy

rm -rf ./user_instances
rm -rf ./pupbot-database
rm -rf ./pupbot-ipc-web-panel-main/node_modules
rm -f ./pupbot-ipc-web-panel-main/public/bundle.js
rm -f ./pupbot-ipc-web-panel-main/logs/main.log
sudo rm -rf /opt/puphook/ipc
sudo rm -f /opt/puphook/bin/libpuphook-textmode.so
sudo rm -f /opt/puphook/bin/libpuphooktextmode.so
