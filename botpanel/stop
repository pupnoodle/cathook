#!/usr/bin/env bash
set -u

echo "Stopping... (this may take a while)"

script_dir="$(CDPATH= cd -- "$(dirname -- "$BASH_SOURCE")" && pwd)"
panel_dir="$script_dir/pupbot-ipc-web-panel-main"
instances_dir="$script_dir/user_instances"
if [ -n "${PUPHOOK_ROOT-}" ]; then install_root="$PUPHOOK_ROOT"; else install_root="/opt/puphook"; fi
ipc_bin="$install_root/ipc/bin"
ipc_state_path="$install_root/ipc/puphook_followbot_server"
if [ -n "${PUP_DEFAULT_DISPLAY-}" ]; then default_headless_display="$PUP_DEFAULT_DISPLAY"; else default_headless_display=":699"; fi
if [ -n "${PUP_XVFB_PID_FILE-}" ]; then xvfb_pid_file="$PUP_XVFB_PID_FILE"; else xvfb_pid_file="/tmp/pupbot-xvfb.pid"; fi
if [ -n "${PUP_CHUNKED_X_DISPLAY_PID_DIR-}" ]; then xvfb_pool_pid_dir="$PUP_CHUNKED_X_DISPLAY_PID_DIR"; else xvfb_pool_pid_dir="/tmp/pupbot-xvfb-pool"; fi
if [ -n "${PUP_IPC_PORT-}" ]; then port="$PUP_IPC_PORT"; else port="7655"; fi

if [ "$(id -u)" -eq 0 ]; then
    sudo_args=()
else
    if ! sudo -n -v 2>/dev/null; then
        sudo -v || { echo "sudo authentication is required to stop root-owned bot processes." >&2; exit 1; }
    fi
    sudo_args=(sudo -n)
fi

as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"; else "${sudo_args[@]}" "$@"; fi
}

if command -v curl >/dev/null 2>&1; then
    curl --connect-timeout 1 --max-time 5 -fsS -X POST \
        -H 'Content-Type: application/x-www-form-urlencoded' --data 'value=0' \
        "http://127.0.0.1:$port/api/quota" >/dev/null 2>&1 || true
    curl --connect-timeout 1 --max-time 2 -fsS \
        "http://127.0.0.1:$port/api/quota/0" >/dev/null 2>&1 || true
fi

if [ "${PUP_VISIBLE_WINDOWS-0}" != "1" ] && command -v xpra >/dev/null 2>&1; then
    if [ -n "${PUP_XPRA_DISPLAY-}" ]; then display="$PUP_XPRA_DISPLAY"
    elif [ -n "${PUP_DISPLAY-}" ]; then display="$PUP_DISPLAY"
    elif [ -n "${PUP_XVFB_DISPLAY-}" ]; then display="$PUP_XVFB_DISPLAY"
    else display="$default_headless_display"; fi
    xpra stop "$display" >/tmp/pupbot-xpra-stop.log 2>&1 || true
fi

if [ -f /tmp/pulsemodule.id ] && command -v pactl >/dev/null 2>&1; then
    pactl unload-module "$(cat /tmp/pulsemodule.id 2>/dev/null)" 2>/dev/null || true
fi

as_root env PANEL_DIR="$panel_dir" INSTANCES_DIR="$instances_dir" IPC_BIN="$ipc_bin" IPC_STATE_PATH="$ipc_state_path" \
    XVFB_PID_FILE="$xvfb_pid_file" XVFB_POOL_PID_DIR="$xvfb_pool_pid_dir" \
    PRESERVE_START_LOCK="${PUP_PRESERVE_START_LOCK-0}" START_PID="${PUP_START_PID-}" bash -s <<'ROOT_STOP_SCRIPT'
set -u
kill_pids=()
bot_roots=()
panel_roots=()

add_pid() {
    candidate="$1"
    existing=""
    [ -n "$candidate" ] || return
    case "$candidate" in ''|*[!0-9]*) return ;; esac
    [ "$candidate" -gt 1 ] 2>/dev/null || return
    for existing in "${kill_pids[@]}"; do [ "$existing" = "$candidate" ] && return; done
    kill_pids+=("$candidate")
}

proc_cmd() { tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null || true; }
proc_cwd() { readlink -f "/proc/$1/cwd" 2>/dev/null || true; }
children_of() { ps -eo pid=,ppid= 2>/dev/null | awk -v parent="$1" '$2 == parent { print $1 }'; }

collect_tree() {
    root="$1"
    child=""
    while read -r child; do [ -n "$child" ] && collect_tree "$child"; done < <(children_of "$root")
    add_pid "$root"
}

is_panel_process() {
    local cwd="$1"
    local cmd="$2"
    case "$cwd" in
        */botpanel/pupbot-ipc-web-panel-main)
            [[ "$cmd" == bash\ ./run.sh* || "$cmd" == /bin/bash\ ./run.sh* ||
               "$cmd" == *"/node app.js "* || "$cmd" == *"/node app.js" ]]
            ;;
        *)
            return 1
            ;;
    esac
}

is_ipc_process() {
    case "$1" in
        */ipc/bin/server|*/ipc/bin/server\ *|*/ipc/bin/console|*/ipc/bin/console\ *) return 0 ;;
        *) return 1 ;;
    esac
}

is_bot_process() {
    case "$1" in
        *--private=*/botpanel/user_instances/*) return 0 ;;
        *) return 1 ;;
    esac
}

is_start_process() {
    local pid="$1"
    local cwd="$2"
    local cmd="$3"
    [ -n "${START_PID-}" ] && [ "$pid" = "$START_PID" ] && return 1
    if [[ "$cmd" == bash\ ./start* || "$cmd" == /bin/bash\ ./start* ]]; then
        return 0
    fi
    case "$cwd" in
        */botpanel)
            [[ "$cmd" == bash\ ./start* || "$cmd" == /bin/bash\ ./start* ]]
            ;;
        *)
            return 1
            ;;
    esac
}

for proc in /proc/[0-9]*; do
    pid="${proc##*/}"
    [ -r "$proc/cmdline" ] || continue
    cmd="$(proc_cmd "$pid")"
    cwd="$(proc_cwd "$pid")"
    if is_panel_process "$cwd" "$cmd"; then
        add_pid "$pid"
        panel_roots+=("$pid")
    fi
    is_start_process "$pid" "$cwd" "$cmd" && add_pid "$pid"
    is_ipc_process "$cmd" && add_pid "$pid"
    is_bot_process "$cmd" && bot_roots+=("$pid")
done

for root in "${panel_roots[@]}"; do collect_tree "$root"; done
for root in "${bot_roots[@]}"; do collect_tree "$root"; done

if [ "${PUP_VISIBLE_WINDOWS-0}" != "1" ]; then
    for pid_file in "$XVFB_PID_FILE" "$XVFB_POOL_PID_DIR"/*.pid; do
        [ -f "$pid_file" ] || continue
        pid="$(tr -cd '0-9' <"$pid_file" 2>/dev/null || true)"
        cmd="$(proc_cmd "$pid")"
        [[ "$cmd" == Xvfb\ :* ]] && add_pid "$pid"
    done
    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        [ -r "$proc/cmdline" ] || continue
        cmd="$(proc_cmd "$pid")"
        [[ "$cmd" == Xvfb\ :699* || "$cmd" == Xvfb\ :7[0-9][0-9]* ]] && add_pid "$pid"
    done
fi

for pid in "${kill_pids[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done
for _ in $(seq 1 50); do
    alive=0
    for pid in "${kill_pids[@]}"; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [ "$alive" -eq 0 ] && break
    sleep 0.2
done
for pid in "${kill_pids[@]}"; do kill -KILL "$pid" 2>/dev/null || true; done

rm -f /tmp/ncat-puphook-webpanel.pid /tmp/pup-ipc-server.pid /tmp/pup-ipc-server.log \
    /tmp/pupbot-xvfb.pid /tmp/pulsemodule.id \
    "$XVFB_POOL_PID_DIR"/*.pid /tmp/source_engine*.lock "$IPC_STATE_PATH" \
    /dev/shm/puphook_followbot_server 2>/dev/null || true
[ "${PRESERVE_START_LOCK-0}" = "1" ] || rm -f /tmp/pupbot-panel-start.lock 2>/dev/null || true

leftovers=0
for proc in /proc/[0-9]*; do
    pid="${proc##*/}"
    [ -r "$proc/cmdline" ] || continue
    cmd="$(proc_cmd "$pid")"
    cwd="$(proc_cwd "$pid")"
    if is_panel_process "$cwd" "$cmd"; then
        echo "still running panel process: $pid $cmd" >&2
        leftovers=1
    fi
    if is_start_process "$pid" "$cwd" "$cmd"; then
        echo "still running start process: $pid $cmd" >&2
        leftovers=1
    fi
    if is_bot_process "$cmd" || is_ipc_process "$cmd"; then
        echo "still running bot/IPC process: $pid $cmd" >&2
        leftovers=1
    fi
done
exit "$leftovers"
ROOT_STOP_SCRIPT

rm -f /tmp/pulsemodule.id 2>/dev/null || true
echo "Stopped!"
