#!/usr/bin/env bash
set -Eeuo pipefail

botid="${1:-}"
if [[ ! "$botid" =~ ^[0-9]+$ ]] || (( botid < 1 || botid > 254 )); then
    echo "bot id must be an integer from 1 to 254" >&2
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    echo "You must be root to run this script"
    exit 1
fi

get_default_interface() {
    local interface=""

    if [[ -n "${PUPHOOK_NET_INTERFACE:-}" ]]; then
        printf '%s\n' "$PUPHOOK_NET_INTERFACE"
        return
    fi

    interface="$(ip -o -4 route get "${PUPHOOK_NET_PROBE_HOST:-1.1.1.1}" 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "dev" && (i + 1) <= NF) {
                    print $(i + 1)
                    exit
                }
            }
        }')"

    if [[ -n "$interface" ]]; then
        printf '%s\n' "$interface"
        return
    fi

    ip -o -4 route show default 2>/dev/null | awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "dev" && (i + 1) <= NF) {
                    print $(i + 1)
                    exit
                }
            }
        }'
}

state_dir="${PUPHOOK_NET_STATE_DIR:-/run/puphook-pupbot}"
lock_path="$state_dir/network.lock"
state_path="$state_dir/state"
mkdir -p "$state_dir"
chmod 700 "$state_dir"
exec {lock_fd}>"$lock_path"
flock "$lock_fd"

NS="pupbotns$botid"
VETH="veth$botid"
VPEER_ADDR="10.200.$botid.2"
INTERFACE="$(get_default_interface || true)"

state_count() {
    if [[ ! -f "$state_path" ]]; then
        printf '0\n'
        return
    fi
    awk 'NR > 1 && NF { count++ } END { print count + 0 }' "$state_path"
}

state_interface() {
    [[ -f "$state_path" ]] && awk -v id="$botid" 'NR > 1 && $1 == id { print $2; exit }'
}

state_remove_id() {
    [[ -f "$state_path" ]] || return 0
    local temporary_path="${state_path}.tmp.$$"
    awk -v id="$botid" 'NR == 1 || $1 != id' "$state_path" > "$temporary_path"
    mv "$temporary_path" "$state_path"
}

state_prune() {
    [[ -f "$state_path" ]] || return 0
    local namespaces
    namespaces="$(ip netns list 2>/dev/null)" || return 0
    local temporary_path="${state_path}.tmp.$$"
    {
        head -n 1 "$state_path"
        while read -r id interface _; do
            [[ -n "$id" ]] || continue
            if grep -Eq "^pupbotns${id}([[:space:]]|$)" <<< "$namespaces"; then
                printf '%s %s\n' "$id" "$interface"
            fi
        done < <(tail -n +2 "$state_path")
    } > "$temporary_path"
    mv "$temporary_path" "$state_path"
}

state_original_forward() {
    [[ -s "$state_path" ]] && head -n 1 "$state_path"
}

remove_rules() {
    local interface="$1"
    [[ -n "$interface" ]] || return 0
    iptables -t nat -D PUPHOOK_PUPBOT -s "${VPEER_ADDR}/24" -o "$interface" -j MASQUERADE 2>/dev/null || true
    iptables -D PUPHOOK_PUPBOT -i "$interface" -o "$VETH" -j ACCEPT 2>/dev/null || true
    iptables -D PUPHOOK_PUPBOT -o "$interface" -i "$VETH" -j ACCEPT 2>/dev/null || true
}

remove_global_rules() {
    iptables -t nat -F PUPHOOK_PUPBOT 2>/dev/null || true
    iptables -F PUPHOOK_PUPBOT 2>/dev/null || true
    iptables -t nat -D POSTROUTING -j PUPHOOK_PUPBOT 2>/dev/null || true
    iptables -D FORWARD -j PUPHOOK_PUPBOT 2>/dev/null || true
    iptables -t nat -X PUPHOOK_PUPBOT 2>/dev/null || true
    iptables -X PUPHOOK_PUPBOT 2>/dev/null || true
}

OLD_FORWARD="$(state_original_forward || true)"
OLD_INTERFACE="$(state_interface || true)"
if [[ -z "$OLD_INTERFACE" ]]; then
    OLD_INTERFACE="$INTERFACE"
fi
state_prune

remove_rules "$OLD_INTERFACE"
if [[ "$INTERFACE" != "$OLD_INTERFACE" ]]; then
    remove_rules "$INTERFACE"
fi
ip netns delete "$NS" 2>/dev/null || true
ip link delete "$VETH" 2>/dev/null || true
state_remove_id

if [[ -f "$state_path" ]] && (( $(state_count) == 0 )); then
    remove_global_rules
    if [[ "$OLD_FORWARD" =~ ^[01]$ ]]; then
        if printf '%s\n' "$OLD_FORWARD" > /proc/sys/net/ipv4/ip_forward; then
            rm -f "$state_path"
        else
            echo "Could not restore net.ipv4.ip_forward" >&2
            exit 1
        fi
    else
        rm -f "$state_path"
    fi
fi
