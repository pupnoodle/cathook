#!/usr/bin/env bash

[[ ! -z "$SUDO_USER" ]] && RUNUSER="$SUDO_USER" || RUNUSER="$LOGNAME"

line=$(pgrep -u "$RUNUSER" -x tf_linux64 || true)
arr=($line)

if [ $# == 1 ]; then
    proc=$1
else
    if [ ${#arr[@]} == 0 ]; then
        echo "TF2 isn't running!"
        exit 1
    fi
    proc=${arr[0]}
fi

echo "Running instances:" "${arr[@]}"
echo "Attaching to $proc"

LIB="$(dirname "$(realpath "$0")")/build/bin/libcathook.so"
if [ ! -f "$LIB" ]; then
    echo "Missing $LIB — build first" >&2
    exit 1
fi

FILENAME="/tmp/.gl$(head /dev/urandom | tr -dc 'a-zA-Z0-9' | head -c 6)"
cp "$LIB" "$FILENAME"
chmod 0755 "$FILENAME"

echo "Loading $FILENAME into $proc"
gdb -n -q -batch                                                      \
    -ex "attach $proc"                                                \
    -ex "echo \033[1mCalling dlopen\033[0m\n"                         \
    -ex "call ((void*(*)(const char*, int))dlopen)(\"$FILENAME\", 1)" \
    -ex "echo \033[1mCalling dlerror\033[0m\n"                        \
    -ex "call ((char*(*)(void))dlerror)()"                            \
    -ex "continue"                                                    \
    -ex "backtrace"

rm -f "$FILENAME"
